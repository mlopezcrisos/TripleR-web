# Copia este archivo a functions/.env y ajusta los dominios.
# Dominios desde los que se puede pagar (separados por coma). El primero
# se usa por defecto. Agrega aquí el dominio real de la tienda.
ALLOWED_ORIGINS=http://localhost:5173,https://tripler-fb8ef.web.app,https://tripler-fb8ef.firebaseapp.com

# Correo de confirmación de pedido (ver README, "Correo de confirmación").
# Si SMTP_USER queda vacío, no se envían correos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
MAIL_FROM=Triple R <tripleerremx@gmail.com>
# Copia oculta de cada confirmación para la tienda (opcional).
MAIL_BCC=
STORE_URL=https://triple-r-web.vercel.app
